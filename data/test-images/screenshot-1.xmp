      xmp:CreatorTool="PictTag"
      pictTag:Medium="Screenshot"
      pictTag:Setting="Unknown"
      pictTag:Symmetry="RadialSymmetry"
      pictTag:RuleOfThirds="False"
      pictTag:ColorVariance="0.100"
      pictTag:EdgeDensity="0.200"
