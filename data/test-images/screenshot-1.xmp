      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Mobile app connection screen</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A screenshot of a mobile application displaying a loading state for connecting to a device. The interface features Norwegian text "Kobler til enheten" and a central signal icon surrounded by concentric circles.</rdf:li>
        </rdf:Alt>
      </dc:description>
