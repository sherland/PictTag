      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Mobile app loading screen</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A screenshot of a mobile application in Norwegian displaying a connection progress screen. It features concentric circles surrounding a Wi-Fi icon and the text 'Kobler til enheten' (Connecting to device) with the number 220 below it.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Screenshot</rdf:li>
          <rdf:li>RadialSymmetry</rdf:li>
          <rdf:li>Wifi Icon</rdf:li>
          <rdf:li>Attachment</rdf:li>
          <rdf:li>Number</rdf:li>
          <rdf:li>Back Button Text</rdf:li>
          <rdf:li>Cancel Button Text</rdf:li>
        </rdf:Bag>
      </dc:subject>
