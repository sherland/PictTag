      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">App connection loading screen</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A mobile app screenshot displaying a connecting status message in Norwegian, "Kobler til enheten," accompanied by the number "220." The interface features a central signal icon surrounded by concentric circles and navigation buttons at the top.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Screenshot</rdf:li>
          <rdf:li>RadialSymmetry</rdf:li>
          <rdf:li>Signal Icon</rdf:li>
          <rdf:li>"Tilbake" Text</rdf:li>
          <rdf:li>"Avbryt" Text</rdf:li>
          <rdf:li>"Kobler Til Enheten" Text</rdf:li>
          <rdf:li>"220" Text</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <Iptc4xmpCore:AltTextAccessibility>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Screenshot of an app's loading screen with a signal icon and Norwegian text indicating it is connecting to a device.</rdf:li>
        </rdf:Alt>
      </Iptc4xmpCore:AltTextAccessibility>
