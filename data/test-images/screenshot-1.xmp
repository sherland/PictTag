      Iptc4xmpExt:DigitalSourceType="https://cv.iptc.org/newscodes/digitalsourcetype/screenCapture">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Mobile app connection screen</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A screenshot of a smartphone displaying an application's loading screen while connecting to a device. The interface features a central Wi-Fi symbol within concentric circles, accompanied by the Norwegian text 'Kobler til enheten' and the number '220'. Navigation options for 'Tilbake' (Back) and 'Avbryt' (Cancel) are visible at the top of the screen.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Screenshot</rdf:li>
          <rdf:li>RadialSymmetry</rdf:li>
          <rdf:li>Wifi Icon</rdf:li>
          <rdf:li>Back Button Text</rdf:li>
          <rdf:li>Cancel Button Text</rdf:li>
          <rdf:li>Connection Status Text</rdf:li>
          <rdf:li>Numeric Value</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <Iptc4xmpCore:AltTextAccessibility>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A screenshot of a mobile app showing a loading screen with a Wi-Fi icon and the text 'Kobler til enheten'.</rdf:li>
        </rdf:Alt>
      </Iptc4xmpCore:AltTextAccessibility>
      <Iptc4xmpCore:ExtDescrAccessibility>
        <rdf:Alt>
