      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Mobile app connection screen</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A screenshot of a smartphone application showing a loading state while connecting to a device. The interface features Norwegian text and a central signal icon surrounded by concentric circles.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Screenshot</rdf:li>
          <rdf:li>RadialSymmetry</rdf:li>
          <rdf:li>Back Button Text</rdf:li>
          <rdf:li>Cancel Button Text</rdf:li>
          <rdf:li>Signal Icon</rdf:li>
          <rdf:li>Connecting Message Text</rdf:li>
          <rdf:li>Number 220</rdf:li>
          <rdf:li>Clock</rdf:li>
          <rdf:li>Battery Percentage</rdf:li>
        </rdf:Bag>
      </dc:subject>
