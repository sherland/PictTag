      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Lawn maintenance in a yard</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">An orange lawnmower sits on a patch of dry grass next to some bare branches. A blue tarp is spread across another part of the yard, and houses and trees are visible in the background under bright sunlight.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
