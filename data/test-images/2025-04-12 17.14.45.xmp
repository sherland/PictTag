      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Orange lawnmower in a yard</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">An orange lawnmower sits on a patch of dry grass in a backyard. In the background, there are several trees, some houses, and a blue tarp spread out on the ground. The scene is captured on a sunny day with long shadows cast by nearby trees.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Photograph</rdf:li>
          <rdf:li>Asymmetrical</rdf:li>
