      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">An orange and white lawn mower sits in a patch of dry grass. A large tree shadow stretches across the foreground, and a blue tarp is visible in the background near some trees.</rdf:li>
        </rdf:Alt>
      </dc:description>
