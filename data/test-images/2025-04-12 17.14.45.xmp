      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Orange lawnmower on a grassy field</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">An orange lawnmower sits on a patch of dry, yellowish grass in an outdoor setting. In the background, there are several trees, houses, and a blue tarp spread out on the ground. A prominent diagonal shadow from a tree branch stretches across the foreground.</rdf:li>
        </rdf:Alt>
      </dc:description>
