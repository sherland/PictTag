      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Lawn mower on a grassy yard</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">An orange lawn mower sits on a patch of dry, brownish grass in a backyard or garden area. In the background, there is a blue tarp spread out on the ground near some trees and houses under a clear sky. A long shadow from an unseen tree stretches across the foreground.</rdf:li>
        </rdf:Alt>
      </dc:description>
