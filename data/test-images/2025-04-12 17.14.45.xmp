      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Lawn mower and blue tarp in a yard</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">An orange lawn mower sits on a patch of dry grass next to some thin branches. A bright blue tarp is spread out across the lawn in the background, and several trees and houses are visible under a clear sky.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
