          <rdf:li>Dough</rdf:li>
          <rdf:li>Appliance</rdf:li>
          <rdf:li>Appliance</rdf:li>
          <rdf:li>Appliance</rdf:li>
          <rdf:li>Table</rdf:li>
        </rdf:Bag>
      </dc:subject>
