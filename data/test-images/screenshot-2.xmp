      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Pizza Oven Setting Guidelines Infographic</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">An infographic titled "SETTING GUIDELINES" providing instructions for using three different pizza oven models: P234H, P134H, and P134HA. It specifies flour types based on hydration levels and presents a detailed table of temperature settings (oven and stone) for various dough hydration percentages ranging from 63% to 78%.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>DigitalIllustration</rdf:li>
          <rdf:li>Infographic</rdf:li>
          <rdf:li>Symmetrical</rdf:li>
          <rdf:li>Title Text</rdf:li>
          <rdf:li>Flour Instructions</rdf:li>
          <rdf:li>Pizza Oven P234h</rdf:li>
          <rdf:li>Pizza Oven P134h</rdf:li>
          <rdf:li>Pizza Oven P134ha</rdf:li>
          <rdf:li>Temperature Settings Table</rdf:li>
          <rdf:li>Brand Logo</rdf:li>
        </rdf:Bag>
      </dc:subject>
