      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Pizza Oven Temperature Settings Guide</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">This infographic provides temperature guidelines for three different pizza oven models: P234H, P134H, and P134HA. It details recommended oven settings and stone temperatures based on dough hydration levels ranging from 63% to 78%. The guide also specifies the appropriate flour types for different hydration ranges.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>DigitalIllustration</rdf:li>
          <rdf:li>Infographic</rdf:li>
