      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Pizza oven setting guidelines</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">An informational infographic providing temperature settings for three different pizza oven models (P234H, P134H, and P134HA) based on dough hydration levels from 63% to 78%. It also includes instructions regarding the appropriate flour type for specific hydration ranges.</rdf:li>
        </rdf:Alt>
      </dc:description>
