      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Pizza Oven Setting Guidelines Infographic</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">This infographic provides temperature setting guidelines for three different pizza oven models: P2_34H, P134H, and P134HA. It details specific oven settings and stone temperatures based on flour type (0-type with W 270 or W 290) and dough hydration levels ranging from 63% to 78%.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>DigitalIllustration</rdf:li>
          <rdf:li>Infographic</rdf:li>
          <rdf:li>Symmetrical</rdf:li>
          <rdf:li>setting guidelines title</rdf:li>
          <rdf:li>flour type instructions</rdf:li>
          <rdf:li>p234h oven</rdf:li>
          <rdf:li>p134h oven</rdf:li>
          <rdf:li>p134ha oven</rdf:li>
          <rdf:li>p234h label</rdf:li>
          <rdf:li>p134h label</rdf:li>
          <rdf:li>p134ha label</rdf:li>
          <rdf:li>hydration and settings table</rdf:li>
          <rdf:li>brand logo</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <Iptc4xmpCore:AltTextAccessibility>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">An infographic displaying temperature setting guidelines for three pizza oven models, P234H, P134H, and P134HA, based on flour type and dough hydration.</rdf:li>
        </rdf:Alt>
      </Iptc4xmpCore:AltTextAccessibility>
