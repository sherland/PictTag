      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Pizza Oven Setting Guidelines</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">An informational graphic providing temperature settings for three different pizza oven models (P234H, P134H, and P134HA). The chart details recommended 'SETTINGS' and 'STONE TEMP.' based on varying dough hydration levels from 63% to 78%.</rdf:li>
        </rdf:Alt>
      </dc:description>
