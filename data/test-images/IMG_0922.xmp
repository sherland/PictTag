      xmp:CreatorTool="PictTag"
      pictTag:Medium="Photograph"
      pictTag:Setting="Outdoor"
      pictTag:Symmetry="Asymmetrical"
      pictTag:RuleOfThirds="False"
      pictTag:ColorVariance="0.300"
