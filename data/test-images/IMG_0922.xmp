      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Cloudy Sky</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A dramatic sky filled with various cloud formations ranging from dark, heavy clouds to lighter, wispy ones. A small portion of a rooftop is visible in the bottom right corner.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Photograph</rdf:li>
          <rdf:li>Asymmetrical</rdf:li>
          <rdf:li>rooftop</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <lr:hierarchicalSubject>
        <rdf:Bag>
          <rdf:li>Medium|Photograph</rdf:li>
          <rdf:li>Symmetry|Asymmetrical</rdf:li>
          <rdf:li>Buildings|rooftop</rdf:li>
        </rdf:Bag>
      </lr:hierarchicalSubject>
      <digiKam:TagsList>
        <rdf:Seq>
          <rdf:li>Medium/Photograph</rdf:li>
          <rdf:li>Symmetry/Asymmetrical</rdf:li>
          <rdf:li>Buildings/rooftop</rdf:li>
        </rdf:Seq>
      </digiKam:TagsList>
      <mwg-rs:Regions rdf:parseType="Resource">
        <mwg-rs:AppliedToDimensions
          stDim:w="3072"
          stDim:h="2048"
          stDim:unit="pixel"/>
