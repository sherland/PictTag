      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Cloudy Sky</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A dramatic view of a sky filled with various cloud formations. Large, dark clouds contrast with lighter, more wispy clouds, with patches of blue sky visible in between.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Photograph</rdf:li>
          <rdf:li>Asymmetrical</rdf:li>
          <rdf:li>Chimney</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <Iptc4xmpCore:AltTextAccessibility>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A wide shot of a cloudy sky featuring large, dark cumulus clouds and lighter white clouds against a blue background.</rdf:li>
        </rdf:Alt>
      </Iptc4xmpCore:AltTextAccessibility>
      <Iptc4xmpCore:ExtDescrAccessibility>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A dramatic view of a sky filled with various cloud formations. Large, dark clouds contrast with lighter, more wispy clouds, with patches of blue sky visible in between.</rdf:li>
        </rdf:Alt>
      </Iptc4xmpCore:ExtDescrAccessibility>
      <Iptc4xmpCore:Scene>
        <rdf:Bag>
          <rdf:li>011000</rdf:li>
