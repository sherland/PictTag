              <mwg-rs:Area
                stArea:x="0.941000"
                stArea:y="0.948500"
                stArea:w="0.072000"
                stArea:h="0.103000"
                stArea:unit="normalized"/>
              </rdf:Description>
            </rdf:li>
          </rdf:Bag>
