      Iptc4xmpExt:DigitalSourceType="https://cv.iptc.org/newscodes/digitalsourcetype/digitalCapture">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Cloudy Sky</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A dramatic sky filled with large, billowing clouds in shades of dark grey and bright white. Small patches of blue sky are visible between the cloud formations. The very bottom of the frame shows a hint of treetops and a chimney.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Photograph</rdf:li>
          <rdf:li>Asymmetrical</rdf:li>
          <rdf:li>Chimney</rdf:li>
          <rdf:li>Tree</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <Iptc4xmpCore:AltTextAccessibility>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Dramatic grey and white cumulus clouds filling an outdoor sky.</rdf:li>
        </rdf:Alt>
      </Iptc4xmpCore:AltTextAccessibility>
      <Iptc4xmpCore:ExtDescrAccessibility>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A dramatic sky filled with large, billowing clouds in shades of dark grey and bright white. Small patches of blue sky are visible between the cloud formations. The very bottom of the frame shows a hint of treetops and a chimney.</rdf:li>
        </rdf:Alt>
