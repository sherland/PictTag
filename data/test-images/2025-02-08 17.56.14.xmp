      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Masquerade Ball Attendees</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A large group of people gathered for a masquerade event, many wearing elaborate masks and costumes. In the foreground, two men pose for a photo, one wearing an ornate silver mask and another in a black eye mask and tuxedo. The background shows a dense crowd within a grand indoor space with classical columns.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Photograph</rdf:li>
          <rdf:li>Asymmetrical</rdf:li>
          <rdf:li>Person</rdf:li>
          <rdf:li>Person</rdf:li>
          <rdf:li>Mask</rdf:li>
          <rdf:li>Mask</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <Iptc4xmpCore:AltTextAccessibility>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A group of people at a masquerade ball, featuring two men in masks prominently in the foreground.</rdf:li>
        </rdf:Alt>
      </Iptc4xmpCore:AltTextAccessibility>
      <Iptc4xmpCore:ExtDescrAccessibility>
