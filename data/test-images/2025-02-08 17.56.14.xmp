      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Guests at a Masquerade Ball</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A large group of people are gathered for a masquerade ball, wearing elaborate masks and formal attire. The foreground features individuals in tuxedos with black and silver masks, set against a backdrop of grand classical columns.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Photograph</rdf:li>
          <rdf:li>Asymmetrical</rdf:li>
          <rdf:li>man in black mask</rdf:li>
          <rdf:li>man in silver mask</rdf:li>
          <rdf:li>woman in black and gold attire</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <Iptc4xmpCore:AltTextAccessibility>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A close-up view of several people wearing decorative masquerade masks and formal clothing at an indoor event.</rdf:li>
        </rdf:Alt>
      </Iptc4xmpCore:AltTextAccessibility>
      <Iptc4xmpCore:ExtDescrAccessibility>
