      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Masquerade Ball Group Photo</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A large group of people dressed in formal attire and various masquerade masks pose for a photograph. The scene is crowded with individuals wearing different styles of eye masks, ranging from simple black ones to ornate silver and gold designs. The image is captured from an angled perspective within an indoor setting featuring classical columns.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Photograph</rdf:li>
          <rdf:li>Asymmetrical</rdf:li>
          <rdf:li>Man In Black Eye Mask</rdf:li>
          <rdf:li>Man In Silver Mask</rdf:li>
          <rdf:li>Woman In Black Eye Mask</rdf:li>
          <rdf:li>Person In Ornate Gown</rdf:li>
          <rdf:li>Person In Ornate Mask</rdf:li>
          <rdf:li>Woman In Gold Mask</rdf:li>
        </rdf:Bag>
      </dc:subject>
