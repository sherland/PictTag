      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Masquerade crowd in line</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A large group of people, including many children, are lined up wearing various decorative masks and elaborate costumes. They appear to be part of a masquerade event or parade, set within a grand indoor space with classical columns. The image is oriented sideways.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Photograph</rdf:li>
          <rdf:li>Asymmetrical</rdf:li>
          <rdf:li>Person</rdf:li>
          <rdf:li>Person</rdf:li>
          <rdf:li>Child</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <Iptc4xmpCore:AltTextAccessibility>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A group of people in festive masquerade attire and masks, lined up in an indoor hall with large columns.</rdf:li>
        </rdf:Alt>
      </Iptc4xmpCore:AltTextAccessibility>
      <Iptc4xmpCore:ExtDescrAccessibility>
