      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Masquerade Attendees</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A large group of people wearing elaborate costumes and masquerade masks are lined up in an indoor setting. In the foreground, two individuals with prominent black and silver masks are captured in a close-up view. The background shows a long queue of costumed guests near classical columns.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Photograph</rdf:li>
          <rdf:li>Asymmetrical</rdf:li>
          <rdf:li>Person</rdf:li>
          <rdf:li>Person</rdf:li>
          <rdf:li>Child</rdf:li>
          <rdf:li>Column</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <Iptc4xmpCore:AltTextAccessibility>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A crowd of people in ornate masquerade costumes and masks standing in line inside a grand hall.</rdf:li>
        </rdf:Alt>
      </Iptc4xmpCore:AltTextAccessibility>
      <Iptc4xmpCore:ExtDescrAccessibility>
