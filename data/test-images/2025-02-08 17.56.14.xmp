      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Masquerade Ball Crowd</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A group of people dressed in elaborate costumes and wearing various decorative masquerade masks at an indoor event. The scene features grand architectural elements like large columns visible in the background.</rdf:li>
        </rdf:Alt>
      </dc:description>
