      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Masquerade Gala</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">A group of people wearing elaborate masquerade masks are gathered at a formal indoor event. The subjects are arranged in a line that recedes into the background, set against a backdrop of classical architectural columns.</rdf:li>
        </rdf:Alt>
      </dc:description>
